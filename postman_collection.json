    {
      "name": "4. AI Providers",
      "item": [
        {
          "name": "List All Providers",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Providers listed', () => pm.response.to.have.status(200));",
                  "var json = pm.response.json();",
                  "if (json.length > 0) {",
                  "  pm.collectionVariables.set('providerId', json[0].id);",
                  "  pm.test('Provider ID saved', () => true);",
                  "}"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/api/providers"
          }
        },
        {
          "name": "Get Provider by ID",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Provider retrieved', () => pm.response.to.have.status(200));"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/api/providers/{{providerId}}"
          }
        },
        {
          "name": "Update Provider",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Provider updated', () => pm.response.to.have.status(200));"
                ]
              }
            }
          ],
          "request": {
            "method": "PATCH",
            "url": "{{baseUrl}}/api/providers/{{providerId}}",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"config\": { \"maxTokens\": 8192, \"temperature\": 0.7 }\n}"
            }
          }
        },
        {
          "name": "Toggle Provider",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Provider toggled', () => pm.response.to.have.status(200));"
                ]
              }
            }
          ],
          "request": {
            "method": "PATCH",
            "url": "{{baseUrl}}/api/providers/{{providerId}}/toggle"
          }
        },
        {
          "name": "Toggle Provider (re-enable)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Provider re-enabled', () => pm.response.to.have.status(200));"
                ]
              }
            }
          ],
          "request": {
            "method": "PATCH",
            "url": "{{baseUrl}}/api/providers/{{providerId}}/toggle"
          }
        },
        {
          "name": "Create Provider (Admin)",
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "exec": [
                  "var timestamp = Date.now();",
                  "pm.collectionVariables.set(\"uniqueSlug\", \"test-provider-\" + timestamp);"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"Provider created\", () => pm.response.to.have.status(201));"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "url": "{{baseUrl}}/api/providers",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Test Provider {{uniqueSlug}}\",\n  \"slug\": \"{{uniqueSlug}}\",\n  \"type\": \"OPENAI\",\n  \"defaultModel\": \"gpt-4o\",\n  \"isEnabled\": true,\n  \"isDefault\": false,\n  \"config\": {\n    \"maxTokens\": 4096,\n    \"temperature\": 0.7\n  }\n}"
            }
          }
        }
      ]
    },
    {
      "name": "5. Chat",
      "item": [
        {
          "name": "Create Conversation",
          "event": [
            {
              "listen": "test",
              "script": {
