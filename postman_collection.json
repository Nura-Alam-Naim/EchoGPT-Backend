          "request": {
            "method": "POST",
            "url": "{{baseUrl}}/api/chat/send/stream",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Accept",
                "value": "text/event-stream"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"message\": \"Write a short poem about coding\"\n}"
            },
            "description": "Returns a Server-Sent Events (SSE) stream. Each event has a partial content chunk. Final event: { \"done\": true }."
          }
        },
        {
          "name": "Delete Conversation",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Conversation deleted', () => pm.response.to.have.status(200));"
                ]
              }
            }
          ],
          "request": {
            "method": "DELETE",
            "url": "{{baseUrl}}/api/chat/conversations/{{conversationId}}"
          }
        }
      ]
