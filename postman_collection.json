            "body": {
              "mode": "raw",
              "raw": "{\n  \"title\": \"Renamed Conversation\"\n}"
            }
          }
        },
        {
          "name": "Send Message",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Send endpoint reachable', () => {",
                  "  pm.expect([201, 400]).to.include(pm.response.code);",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "url": "{{baseUrl}}/api/chat/send",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"message\": \"Explain quantum computing in simple terms\",\n  \"conversationId\": \"{{conversationId}}\"\n}"
            },
            "description": "Note: Requires a configured AI provider with API key to return a full AI response."
          }
        },
        {
          "name": "Send Message (Streaming SSE)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Stream endpoint reachable', () => {",
                  "  pm.expect([200, 201, 400]).to.include(pm.response.code);",
